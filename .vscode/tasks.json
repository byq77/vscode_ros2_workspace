{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        // Build tasks
        {
            "label": "build workspace",
            "detail": "Build the workspace (default)",
            "type": "shell",
            "command": ". /ros_ws/.devcontainer/scripts/build.sh all",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "options": {
                "env": {
                    "BUILD_TYPE": "${input:buildType}",
                    "USE_MERGE_INSTALL": "${input:useMergeInstall}",
                    "USE_SYMLINK_INSTALL": "${input:useSymlinkInstall}",
                    "USE_CMAKE_CLEAN_FIRST": "${input:useCmakeCleanTargetFirst}",
                    "USE_CMAKE_CLEAN_CACHE": "${input:useCmakeCleanCache}"
                }
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "build pkg",
            "detail": "Build a specific package from the workspace.",
            "type": "shell",
            "command": ". /ros_ws/.devcontainer/scripts/build.sh ${input:packageName}",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "options": {
                "env": {
                    "BUILD_TYPE": "${input:buildType}",
                    "USE_MERGE_INSTALL": "${input:useMergeInstall}",
                    "USE_SYMLINK_INSTALL": "${input:useSymlinkInstall}",
                    "USE_CMAKE_CLEAN_FIRST": "${input:useCmakeCleanTargetFirst}",
                    "USE_CMAKE_CLEAN_CACHE": "${input:useCmakeCleanCache}"
                }
            },
            "problemMatcher": "$gcc"
        },
        // Test tasks
        {
            "label": "test",
            "detail": "Run all unit tests and show results.",
            "type": "shell",
            "command": ". /ros_ws/.devcontainer/scripts/test.sh",
            "options": {
                "env": {
                    "USE_MERGE_INSTALL": "${input:useMergeInstall}"
                }
            },
            "group": {
                "kind": "test",
                "isDefault": true
            }
        },
        // Purge
        {
            "label": "purge",
            "detail": "Purge the workspace by deleting all generated files.",
            "type": "shell",
            "command": "sudo rm -fr build install log; sudo py3clean .",
            "problemMatcher": []
        },
        // Source
        {
            "label": "source",
            "detail": "Source the workspace",
            "type": "shell",
            "command": "source /opt/ros/${env:ROS_DISTRO}/setup.bash",
            "problemMatcher": []
        },
        // Linting and static code analysis tasks
        {
            "label": "uncrustify format pkg",
            "detail": "Reformat all cpp files in a package with uncrustify.",
            "type": "shell",
            "command": "ament_uncrustify",
            "args": [
                "--reformat",
                "src/${input:packageName}"
            ],
            "problemMatcher": []
        },
        {
            "label": "uncrustify format file",
            "detail": "Reformat the current cpp file with uncrustify.",
            "type": "shell",
            "command": "ament_uncrustify",
            "args": [
                "--reformat",
                "${relativeFile}"
            ],
            "problemMatcher": []
        },
        {
            "label": "uncrustify pkg",
            "detail": "Lint all cpp files in a package with uncrustify.",
            "type": "shell",
            "command": "ament_uncrustify",
            "args": [
                "src/${input:packageName}"
            ],
            "presentation": {
                "panel": "dedicated",
                "reveal": "silent",
                "clear": true
            },
            "problemMatcher": [
                {
                    "owner": "uncrustify",
                    "source": "uncrustify",
                    "fileLocation": "relative",
                    "pattern": [
                        // just the file name message
                        {
                            "regexp": "^(.*)'(.*)':",
                            "kind": "file",
                            "file": 2,
                            "message": 1
                        }
                    ]
                }
            ]
        },
        {
            "label": "uncrustify file",
            "detail": "Lint the current cpp file with uncrustify.",
            "type": "shell",
            "command": "ament_uncrustify",
            "args": [
                "${relativeFile}"
            ],
            "presentation": {
                "panel": "dedicated",
                "reveal": "silent",
                "clear": true
            },
            "problemMatcher": [
                {
                    "owner": "uncrustify",
                    "source": "uncrustify",
                    "fileLocation": "relative",
                    "pattern": [
                        // just the file name message
                        {
                            "regexp": "^(.*)'(.*)':",
                            "kind": "file",
                            "file": 2,
                            "message": 1
                        }
                    ]
                }
            ]
        },
        {
            "label": "cpplint pkg",
            "detail": "Lint cpp files with cpplint in a package.",
            "type": "ament",
            "task": "cpplint",
            "path": "src/${input:packageName}",
            "problemMatcher": "$ament_cpplint",
            "presentation": {
                "panel": "dedicated",
                "reveal": "silent",
                "clear": true
            },
        },
        {
            "label": "cpplint file",
            "detail": "Lint the current file with cpplint.",
            "type": "ament",
            "task": "cpplint",
            "path": "${relativeFile}",
            "problemMatcher": "$ament_cpplint",
            "presentation": {
                "panel": "dedicated",
                "reveal": "silent",
                "clear": true
            },
        },
        {
            "label": "cppcheck pkg",
            "detail": "Run static code checker with cppcheck in a package.",
            "type": "ament",
            "task": "cppcheck",
            "path": "src/${input:packageName}",
            "problemMatcher": "$ament_cppcheck",
            "presentation": {
                "panel": "dedicated",
                "reveal": "silent",
                "clear": true
            },
            "options": {
                "env": {
                    "AMENT_CPPCHECK_ALLOW_SLOW_VERSIONS": "1"
                }
            }
        },
        {
            "label": "cppcheck file",
            "detail": "Run static code checker with cppcheck on the current file.",
            "type": "ament",
            "task": "cppcheck",
            "path": "${relativeFile}",
            "problemMatcher": "$ament_cppcheck",
            "presentation": {
                "panel": "dedicated",
                "reveal": "silent",
                "clear": true
            },
            "options": {
                "env": {
                    "AMENT_CPPCHECK_ALLOW_SLOW_VERSIONS": "1"
                }
            }
        },
        {
            "label": "lint_cmake pkg",
            "detail": "Run lint on cmake files in a package.",
            "type": "ament",
            "task": "lint_cmake",
            "path": "src/${input:packageName}",
            "problemMatcher": "$ament_lint_cmake",
            "presentation": {
                "panel": "dedicated",
                "reveal": "silent",
                "clear": true
            }
        },
        {
            "label": "flake8 pkg",
            "detail": "Run flake8 on python files in a package.",
            "type": "ament",
            "task": "flake8",
            "path": "src/${input:packageName}",
            "problemMatcher": "$ament_flake8",
            "presentation": {
                "panel": "dedicated",
                "reveal": "silent",
                "clear": true
            }
        },
        {
            "label": "flake8 file",
            "detail": "Run flake8 on the current python file.",
            "type": "ament",
            "task": "flake8",
            "path": "${relativeFile}",
            "problemMatcher": "$ament_flake8",
            "presentation": {
                "panel": "dedicated",
                "reveal": "silent",
                "clear": true
            }
        },
        {
            "label": "pep257 pkg",
            "detail": "Run pep257 on python files in a package.",
            "type": "ament",
            "task": "pep257",
            "path": "src/${input:packageName}",
            "problemMatcher": "$ament_pep257",
            "presentation": {
                "panel": "dedicated",
                "reveal": "silent",
                "clear": true
            }
        },
        {
            "label": "pep257 file",
            "detail": "Run pep257 on the current python file.",
            "type": "ament",
            "task": "pep257",
            "path": "${relativeFile}",
            "problemMatcher": "$ament_pep257",
            "presentation": {
                "panel": "dedicated",
                "reveal": "silent",
                "clear": true
            }
        },
        {
            "label": "xmllint pkg",
            "detail": "Run xmllint on xml files in a package.",
            "type": "ament",
            "task": "xmllint",
            "path": "src/${input:packageName}",
            "problemMatcher": "$ament_xmllint",
            "presentation": {
                "panel": "dedicated",
                "reveal": "silent",
                "clear": true
            }
        },
        {
            "label": "lint pkg",
            "detail": "Run all linters on a package.",
            "dependsOn": [
                "cppcheck pkg",
                "cpplint pkg",
                "flake8 pkg",
                "lint_cmake pkg",
                "pep257 pkg",
                "xmllint pkg",
                "uncrustify pkg"
            ],
            "problemMatcher": []
        },
        // Documentation
        {
            "label": "create pkg doc config",
            "detail": "Create a default documentation config for a package.",
            "type": "shell",
            "command": "rosdoc2",
            "args": [
                "default_config",
                "--package-path",
                "/ros_ws/src/${input:packageName}"
            ],
            "problemMatcher": []
        },
        {
            "label": "build pkg doc",
            "detail": "Build the documentation for a package.",
            "type": "shell",
            "command": "rosdoc2",
            "args": [
                "build",
                "--package-path",
                "/ros_ws/src/${input:packageName}",
                "--output-directory",
                "/ros_ws/docs/out/",
                "--cross-reference-directory",
                "/ros_ws/docs/cross_reference",
                "--doc-build-directory",
                "/ros_ws/docs/build",
            ],
            "problemMatcher": []
        },
        // Workspace editing tasks
        {
            "label": "new ament_cmake package",
            "detail": "Create a new ROS cpp package from a template.",
            "type": "shell",
            "command": "ros2 pkg create --destination-directory src --build-type ament_cmake ${input:packageName}",
            "problemMatcher": []
        },
        {
            "label": "new ament_python package",
            "detail": "Create a new ROS python package from a template.",
            "type": "shell",
            "command": "ros2 pkg create --destination-directory src --build-type ament_python ${input:packageName}",
            "problemMatcher": []
        },
        {
            "label": "import from workspace file",
            "detail": "Use vcs to import modules specified by a workspace/rosinstall file.",
            "type": "shell",
            "command": "envsubst < src/ros2.repos | vcs import src",
            "problemMatcher": []
        },
        {
            "label": "update workspace file",
            "detail": "Use vcs to update repositories in src to workspace file.",
            "type": "shell",
            "command": "vcs export src > src/ros2.repos",
            "problemMatcher": []
        },
        {
            "label": "install dependencies",
            "detail": "Install all dependencies specified in the workspaces package.xml files.",
            "type": "shell",
            "command": "sudo apt-get update && rosdep update && rosdep install --from-paths src --ignore-src -y",
            "problemMatcher": []
        },
        {
            "label": "setup",
            "detail": "Set up the workspace",
            "type": "shell",
            "command": ". /ros_ws/.devcontainer/scripts/setup.sh",
            "problemMatcher": []
        },
        {
            "label": "add submodules from .repos",
            "detail": "Create a git submodule for all repositories in your .repos file",
            "type": "shell",
            "command": "python3 .devcontainer/scripts/repos_to_submodules.py",
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "packageName",
            "type": "promptString",
            "description": "Enter the name of the package",
            "default": "my_package"
        },
        {
            "id": "buildType",
            "type": "pickString",
            "description": "Select the build type",
            "default": "RelWithDebInfo",
            "options": [
                "Debug",
                "Release",
                "RelWithDebInfo",
                "MinSizeRel",
            ]
        },
        {
            "id": "useMergeInstall",
            "type": "pickString",
            "description": "Do you want to use the merged install space?",
            "default": "true",
            "options": [
                "true",
                "false"
            ]
        },
        {
            "id": "useSymlinkInstall",
            "type": "pickString",
            "description": "Do you want to use the symlink install space?",
            "default": "true",
            "options": [
                "true",
                "false"
            ]
        },
        {
            "id": "useCmakeCleanTargetFirst",
            "type": "pickString",
            "description": "Do you want to run clean target first?",
            "default": "false",
            "options": [
                "true",
                "false"
            ]
        },
        {
            "id": "useCmakeCleanCache",
            "type": "pickString",
            "description": "Do you want to clean the CMake cache?",
            "default": "false",
            "options": [
                "true",
                "false"
            ]
        },
    ]
}